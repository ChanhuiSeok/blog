# ──────────────────────────────────────────────
# 운영 DB 스키마 반영(db:push:prod) 전용 템플릿
# 이 파일을 .env.production.local 로 복사한 뒤 값을 채우세요.
#   cp .env.production.local.example .env.production.local
# (.env.production.local 은 gitignore 되어 커밋되지 않습니다)
#
# 주의: 운영 앱의 환경변수는 Vercel 대시보드에서 관리합니다.
#       이 파일은 오직 로컬에서 `npm run db:push:prod` 로
#       운영 Turso DB 에 스키마를 적용할 때만 사용됩니다.
# ──────────────────────────────────────────────

# 운영 Turso 데이터베이스 URL (libsql:// 로 시작)
TURSO_DATABASE_URL=
# 운영 Turso 인증 토큰
TURSO_AUTH_TOKEN=
