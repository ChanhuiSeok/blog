# ──────────────────────────────────────────────
# 로컬 개발용 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.local.example .env.local
# (.env.local 은 gitignore 되어 커밋되지 않습니다)
# ──────────────────────────────────────────────

# Database — 로컬은 파일 기반 SQLite 를 사용합니다.
# db:push / db:seed / db:studio 가 이 값을 읽습니다.
TURSO_DATABASE_URL=file:./db.sqlite
# 로컬(파일 DB)에서는 불필요. 운영(libsql://)에서만 필요합니다.
# TURSO_AUTH_TOKEN=

# Auth — 어드민 로그인.
# npm run password:hash 로 해시를 생성해 채우세요.
ADMIN_PASSWORD_HASH=
# 32자 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=

# Cloudinary — 이미지 업로드.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
